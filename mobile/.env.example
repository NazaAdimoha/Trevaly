# Copy to `.env` — Expo reads EXPO_PUBLIC_* into the client bundle.
#
# These are INLINED AT BUILD TIME, not read at runtime. Changing either value
# means restarting Metro with `npm run start:reset`; a plain restart keeps the
# cached bundle and the old value silently stays in force.

# The publishable key is the SAME one the web app uses: one Clerk instance means
# a merchant has one account and one password across both surfaces.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the API lives. Three valid answers, in order of preference:
#
#   1. A DEPLOYED URL — https://your-project.vercel.app
#      Preferred. The phone works on any network with no laptop running, which
#      is the only setup that survives a merchant actually using the app.
#      `isPlatformHost` already treats *.vercel.app as the platform host, so a
#      preview URL works with no code change.
#
#   2. THIS MACHINE'S LAN ADDRESS — http://192.168.x.x:3000
#      For a physical device against a local dev server. Must be the LAN
#      address, never localhost: the phone's localhost is the phone. Re-check it
#      after joining a different network — a stale address here is
#      indistinguishable from "the app is broken", because every screen simply
#      renders empty.
#
#   3. http://localhost:3000
#      Simulators and the iOS/Android emulator only.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

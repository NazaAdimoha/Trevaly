# Copy to `.env`. Parsed and validated at boot (src/config/env.ts): the API
# refuses to start on a missing or malformed setting, naming it.

NODE_ENV="development"
PORT=4000

# ─── Database (the API is the only app that connects) ────────────────────────
# Pooled (-pooler) endpoint for the app; direct endpoint for migrations only.
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
# Per instance. Instances × this must stay under the pooler's limit.
DB_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────────────────────
# Shared rate limits. Optional in development (in-memory fallback, with a
# warning); required in production.
REDIS_URL=""

# ─── Clerk ───────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
# Optional PEM public key: verifies session tokens with no network call.
CLERK_JWT_KEY=""
# Browser origins a session token may come from, comma-separated. Tokens with
# no origin (the mobile app's) are accepted.
CLERK_AUTHORIZED_PARTIES="http://localhost:3000"

# ─── Web proxy ───────────────────────────────────────────────────────────────
# The same value as INTERNAL_API_KEY in the web app's .env. Required in
# production. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=""
# Browser origins allowed to call the API directly (CORS).
CORS_ORIGINS="http://localhost:3000"
# Load-balancer hops in front of the API (Render: 1).
TRUST_PROXY_HOPS=1

# ─── Domain ──────────────────────────────────────────────────────────────────
ROOT_DOMAIN="yourbrand.com"

# ─── Paystack ────────────────────────────────────────────────────────────────
# Use sk_test_… in development. Check with: pnpm check:paystack
PAYSTACK_SECRET_KEY=""

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Jobs ────────────────────────────────────────────────────────────────────
# Bearer secret for GET /api/jobs/expire-orders. Unset: the job refuses to run.
CRON_SECRET=""

# ─── Mobile ──────────────────────────────────────────────────────────────────
MOBILE_MINIMUM_VERSION="1.0.0"

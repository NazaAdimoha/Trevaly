# ─── Database ────────────────────────────────────────────────────────────────
# Pooled connection (PgBouncer) for the app; direct connection for migrations.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── Platform domain ─────────────────────────────────────────────────────────
# The domain you sell subdomains under. A tenant storefront lives at
# {slug}.$ROOT_DOMAIN; your marketing site + dashboard live at $ROOT_DOMAIN.
ROOT_DOMAIN="yourbrand.com"
NEXT_PUBLIC_ROOT_DOMAIN="yourbrand.com"

# ─── Clerk (identity only — tenancy lives in our own TenantUser table) ───────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Paystack ────────────────────────────────────────────────────────────────
# One platform integration. Per-tenant settlement happens via Subaccounts, so
# funds never touch a platform-controlled account.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ─── Vercel (custom domain automation at tenant onboarding) ──────────────────
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# ─── Media ───────────────────────────────────────────────────────────────────
# The cloud name is needed in the browser too: `next-cloudinary` builds delivery
# URLs client-side, so it reads the NEXT_PUBLIC_ copy. Same value, and safe to
# expose — it already appears in every image URL. The key and secret must never
# be given a NEXT_PUBLIC_ prefix; they sign uploads.
CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
# The upload widget sends the API key alongside the signature, so it needs the
# NEXT_PUBLIC_ copy too. Safe: the key identifies the account, it does not
# authorize anything on its own — only the secret below signs, and it must
# never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
ORDER_EMAIL_FROM="orders@yourbrand.com"

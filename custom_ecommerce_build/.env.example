# ─── API ─────────────────────────────────────────────────────────────────────
# The web app has no database and no payment or media secrets. Every /api
# request is forwarded here by proxy.ts, and Server Components read from here.
# Database, Paystack secret and Cloudinary secret live in ../api/.env.
API_ORIGIN="http://localhost:4000"
# The same value as INTERNAL_API_KEY in ../api/.env. Lets the API trust the
# shopper IP and host this proxy forwards, and resolve custom domains.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=""

# ─── Platform domain ─────────────────────────────────────────────────────────
# The domain you sell subdomains under. A tenant storefront lives at
# {slug}.$ROOT_DOMAIN; your marketing site + dashboard live at $ROOT_DOMAIN.
ROOT_DOMAIN="yourbrand.com"
NEXT_PUBLIC_ROOT_DOMAIN="yourbrand.com"

# ─── Clerk (identity only — tenancy lives in our own TenantUser table) ───────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Paystack ────────────────────────────────────────────────────────────────
# Public key only. The secret key belongs to the API; `pnpm --dir ../api
# check:paystack` checks that the two are in the same mode.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ─── Vercel (custom domain automation at tenant onboarding) ──────────────────
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# ─── Media ───────────────────────────────────────────────────────────────────
# Needed in the browser: `next-cloudinary` builds delivery URLs client-side.
# Safe to expose — it already appears in every image URL. The API key and
# secret that sign uploads live in ../api/.env; the upload widget receives the
# key from the API's signature endpoint.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
ORDER_EMAIL_FROM="orders@yourbrand.com"
